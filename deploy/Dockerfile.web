# Static frontend behind Caddy, which also terminates TLS and proxies /api.
#
# The bundle is baked into the image rather than shared through a volume: it is
# 336 KB, it belongs to the commit that produced it, and a volume would let the
# page and the API drift apart across deploys.
FROM node:22-alpine AS build

WORKDIR /build

# npm ci needs the lockfile and nothing else to resolve; keeping this layer
# separate means a source-only change does not reinstall 162 MB of packages.
COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web ./
RUN npm run build

FROM caddy:2-alpine AS runtime

COPY --from=build /build/dist /srv/www
COPY deploy/Caddyfile /etc/caddy/Caddyfile
