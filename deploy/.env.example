# Copy to deploy/.env on the server and edit. Never commit the real file.

# Hostname for automatic HTTPS. Leave empty to serve plain HTTP on :80 while
# testing by IP address; set it once DNS points at the server and Caddy will
# obtain a Let's Encrypt certificate on the first request.
SITE_ADDRESS=

# 1 = imports and lap tagging are not registered at all (they answer 404).
# Do not set this to 0 until there is authentication in front of the API.
PACE_READ_ONLY=1
